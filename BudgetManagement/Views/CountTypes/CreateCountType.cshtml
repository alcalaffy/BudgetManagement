@model CountType

@{
    ViewData["Title"] = "Create Count Type";
}

<h1>Create Count Type</h1>

<div asp-validation-summary="ModelOnly" class="text-danger">

</div>
<form asp-action="CreateCountType" method="post">
    <div class="mb-3">
        <label asp-for="Nombre" class="col-form-label"></label>
        <input asp-for="Nombre" type="text" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">
        Send
    </button>
    <a class="btn btn-danger" asp-action="Index">Cancel</a>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}