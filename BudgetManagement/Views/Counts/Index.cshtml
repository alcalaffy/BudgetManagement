@model IEnumerable<IndexCountsViewModel>
@{
    ViewData["Title"] = "Counts";
    string parseBalance(decimal balance)
    {
        return Math.Abs(balance).ToString("N");
    }
    string getBalance(decimal balance)
    {
        return balance >= 0 ? "active" : "pasive";
    }
}
<h1>Counts</h1>
<a class="btn btn-primary" asp-action="Create">Create</a>
<div class="total-container mb-3">
    <div>
        <div>
            <strong>Active</strong>
        </div>
        <div class="active">
            @parseBalance(Model.Where(c=>c.Balance > 0).Sum(c =>c.Balance))
        </div>
    </div>
    <div>
        <div>
            <strong>Pasive</strong>
        </div>
        <div class="pasive">
            @parseBalance(Model.Where(c=>c.Balance < 0).Sum(c =>c.Balance))
        </div>
    </div>
    <div>
        <div>
            <strong>Total</strong>
        </div>
        <div>
            @parseBalance(Model.Sum(c=>c.Balance))
        </div>
    </div>
</div>
<div class=" accordion accordion-counts">
    @foreach(var c in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                @{
                    var id = c.TipoCuenta.Replace(" ", "");
                    var dataBSTarget = "#" + id;
                    var typeCountClass = getBalance(c.Balance);
                }
            
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="@dataBSTarget">
                    <span class="mb-3">
                        <span><strong>@c.TipoCuenta</strong></span>
                        <span class="@typeCountClass">@parseBalance(c.Balance)</span>

                    </span>
                </button>
            </h2>
        </div>
        <div id="@id" class="accordion-collapse collapse show">
            <div>
                <ul class="list-group">
                    @foreach(var count in c.Cuentas)
                    {
                        var classCount = getBalance(count.Balance);
                        <li class="list-group-item">
                            <span><strong>@count.Nombre</strong></span>
                            <span class="@classCount">@parseBalance(count.Balance)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>