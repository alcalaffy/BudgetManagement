@model Count;
@{
    ViewData["Title"] = "Delete Count";
}
<h3 class="mb-3">Are you sure to delete the count: @Model.Nombre</h3>
<form asp-action="DeleteCount">
    <input hidden asp-for="Id" />
    <button class="btn btn-danger">Delete</button>
    <a class="btn btn-primary" asp-action="Index">Cancel</a>
</form>