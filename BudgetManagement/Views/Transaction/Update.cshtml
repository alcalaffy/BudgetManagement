@model UpdateTransactionViewModel;
@{
    ViewData["Title"] = "Update Transaction";
}
<h1>Update Transaction</h1>
<form asp-action="Update">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input hidden asp-for="Id" />
    <input hidden asp-for="MontoAnterior" />
    <input hidden asp-for="CuentaAnterior" />
    <div class="mb-3">
        <label asp-for="FechaTransaccion" class="form-label"></label>
        <input asp-for="FechaTransaccion" class="form-control" />
        <span asp-validation-for="FechaTransaccion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CuentaId" class="form-label"></label>
        <select class="form-select" asp-for="CuentaId" asp-items="@Model.Cuentas"></select>
        <span asp-validation-for="CuentaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="OperationTypeId" class="form-label"></label>
        <select class="form-select" asp-for="OperationTypeId" asp-items="Html.GetEnumSelectList<OperationType>()"></select>
        <span asp-validation-for="OperationTypeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select class="form-select" asp-for="CategoriaId" asp-items="@Model.Categorias"></select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nota" class="form-label"></label>
        <textarea asp-for="Nota" class="form-control"></textarea>
        <span asp-validation-for="Nota" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Send</button>
    <button class="btn btn-danger" type="submit" asp-action="Delete">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="./js/TransactionForm.js" asp-append-version="true"></script>
    <script>
        const url = '@Url.Action("GetCategoriesByOperation")';

        $(function () {
            InitialiceTransactionForm(url);
        });
    </script>
}